#!/usr/bin/env bash
# Put real photographs into the demo site.
#
#   1. Drop images into demo-assets/photography/ using these names:
#        hero.jpg  gallery-1.jpg … gallery-6.jpg
#   2. ./scripts/studio-images
#   3. ./scripts/studio
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$ROOT/demo-assets/photography"
OUT="$ROOT/desktop/src/features/preview-studio/lib/demo/photographs.ts"

[ -d "$SRC" ] || { echo "No $SRC — create it and add images."; exit 1; }

node - "$SRC" "$OUT" <<'NODE'
const fs = require("fs");
const path = require("path");
const [, , src, out] = process.argv;

const WANTED = ["hero", "gallery-1", "gallery-2", "gallery-3", "gallery-4", "gallery-5", "gallery-6"];
const MIME = { ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".png": "image/png", ".webp": "image/webp" };

const entries = [];
let found = 0;
for (const name of WANTED) {
  const hit = fs.readdirSync(src).find((f) => path.parse(f).name === name && MIME[path.extname(f).toLowerCase()]);
  if (!hit) { console.log(`  missing: ${name}`); continue; }
  const file = path.join(src, hit);
  const b64 = fs.readFileSync(file).toString("base64");
  const mime = MIME[path.extname(hit).toLowerCase()];
  const kb = Math.round(fs.statSync(file).size / 1024);
  console.log(`  ${name.padEnd(11)} ${hit}  ${kb}KB`);
  entries.push(`  "images/${name}.jpg": "data:${mime};base64,${b64}",`);
  found++;
}

if (!found) { console.log("No usable images found."); process.exit(1); }

fs.writeFileSync(out, `/** Real photography for the demo site. Generated by scripts/studio-images. */
export const REAL_PHOTOGRAPHS: Record<string, string> = {
${entries.join("\n")}
};
`);
console.log(`\n→ wrote ${found} image(s) into ${path.basename(out)}`);
NODE

echo "→ Now run ./scripts/studio"
